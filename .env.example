# Backend do sistema. Escolha UM dos dois modos:

# 1) Supabase (cliente oficial)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 2) Qualquer servidor com o contrato PostgREST (POST {URL}/rpc/{funcao}):
#    Supabase (https://SEU-PROJETO.supabase.co/rest/v1), PostgREST próprio ou backend compatível.
#    Quando definido, tem prioridade sobre o modo 1.
# VITE_API_URL=http://localhost:3000
# VITE_API_CHAVE=

# Endereço público do gateway da API de integrações (api-gateway/), usado nos exemplos da tela de chaves
# VITE_API_PUBLICA_URL=https://api.suaempresa.com.br
